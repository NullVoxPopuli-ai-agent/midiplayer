{
  "name": "midiplayer",
  "version": "0.0.0",
  "private": true,
  "description": "Your Ember App's description here",
  "repository": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.ts",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "vite",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "build:test": "EMBER_ENV=test NODE_ENV=development vite build --mode development",
    "test:ci": "testem ci --port 0",
    "test": "pnpm build:test && pnpm test:ci",
    "lint:types": "ember-tsc --noEmit"
  },
  "dependencies": {
    "@embroider/macros": "1.20.5",
    "@embroider/router": "3.0.6",
    "@glimmer/component": "2.1.1",
    "@ryohey/wavelet": "0.7.6",
    "decorator-transforms": "2.4.0",
    "ember-modifier": "^4.3.0",
    "ember-source": "7.0.0",
    "ember-strict-application-resolver": "0.1.1",
    "midifile-ts": "1.5.2",
    "nvp.ui": "0.5.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@ember/app-tsconfig": "2.0.0",
    "@ember/test-helpers": "5.4.3",
    "@ember/test-waiters": "4.1.2",
    "@embroider/core": "4.6.2",
    "@glint/ember-tsc": "1.8.12",
    "@glint/template": "1.7.8",
    "@glint/tsserver-plugin": "2.5.18",
    "@nullvoxpopuli/ember-vite": "1.0.3",
    "@nullvoxpopuli/eslint-configs": "5.5.0",
    "@rollup/plugin-babel": "7.1.0",
    "@types/qunit": "2.19.14",
    "babel-plugin-ember-template-compilation": "4.0.0",
    "concurrently": "9.2.4",
    "ember-qunit": "9.1.0",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "prettier-plugin-ember-template-tag": "2.1.7",
    "qunit": "2.26.0",
    "qunit-dom": "3.5.0",
    "qunit-theme-ember": "1.0.0",
    "testem": "3.17.0",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  }
}
